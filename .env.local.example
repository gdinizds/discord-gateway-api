# PostgreSQL — API user (DML only: SELECT, INSERT, UPDATE, DELETE)
DB_URL=jdbc:postgresql://localhost:5432/gateway
DB_USERNAME=gateway_api
DB_PASSWORD=your-api-password-here

# PostgreSQL — Flyway user (DDL: CREATE, ALTER, DROP, extensions)
# Spring Boot picks these up automatically — no YAML entry needed
SPRING_FLYWAY_USER=gateway_migration
SPRING_FLYWAY_PASSWORD=your-migration-password-here

# Redpanda
REDPANDA_BOOTSTRAP_SERVERS=localhost:9092

# Discord
DISCORD_BOT_TOKEN=your-discord-bot-token-here

# Garage (S3-compatible)
GARAGE_ENDPOINT=http://192.168.10.96
GARAGE_BUCKET=discord-attachments
GARAGE_REGION=garage
GARAGE_ACCESS_KEY=your-access-key-here
GARAGE_SECRET_KEY=your-secret-key-here
